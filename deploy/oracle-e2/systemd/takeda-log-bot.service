[Unit]
Description=Takeda-Log Discord Bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=opc
WorkingDirectory=/opt/takeda-log-bot
Environment=HOME=/opt/takeda-log-bot/.runtime-home
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/takeda-log-bot/.venv/bin/python /opt/takeda-log-bot/bot.py
Restart=always
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
