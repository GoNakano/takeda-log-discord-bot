DISCORD_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=
# コマンドを受け付けるサーバーID（カンマ区切り）。未設定ならDISCORD_GUILD_IDを使う
DISCORD_ALLOWED_GUILD_IDS=
TAKEDA_HISTORY_URL=https://takeda-log.example/school_view_time/your_school_id
TAKEDA_CSV_PATH=data/latest.csv
TAKEDA_PROFILE_DIR=.takeda-profile
TAKEDA_AUTH_STATE=.takeda-auth.json
TAKEDA_BROWSER_CHANNEL=chromium
TAKEDA_DOWNLOAD_HEADLESS=false
UPDATE_START_HOUR=9
UPDATE_END_HOUR=23
UPDATE_INTERVAL_MINUTES=10
TAKEDA_LOGIN_EMAIL=
TAKEDA_LOGIN_PASSWORD=
DISCORD_ALERT_USER_ID=
ALERT_AFTER_MINUTES=60
ALERT_REPEAT_HOURS=6
